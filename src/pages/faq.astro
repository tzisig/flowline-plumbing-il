---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { faq, services } from '../config/site.config';
import { breadcrumbSchema, faqSchema, home } from '../lib/schema';

const crumbs = [home, { label: 'שאלות נפוצות', href: '/faq/' }];
const all = [...faq, ...services.flatMap((s) => s.faq)];
---
<BaseLayout
  title="שאלות נפוצות על אינסטלציה ועל המוקד"
  description="זמני הגעה, תוספת לילה, מחירים, אחריות, ועדי בית וביטוח, ושאלות על סתימות, נזילות, דודים ומשאבות."
  schema={[breadcrumbSchema(crumbs), faqSchema(all)]}
>
  <PageHead crumbs={crumbs} title="שאלות נפוצות" lead="לא מצאתם תשובה? המוקד עונה גם על שאלות, בכל שעה." />
  <section class="section">
    <div class="wrap groups">
      <section class="group">
        <h2>המוקד, מחירים ואחריות</h2>
        <FaqList items={faq} />
      </section>
      {services.map((s) => (
        <section class="group" style={`--line:${s.color}`}>
          <h2><a href={`/services/${s.slug}/`}>{s.title}</a></h2>
          <FaqList items={s.faq} />
        </section>
      ))}
    </div>
  </section>
  <CtaBand />
</BaseLayout>

<style>
  .groups { display: grid; gap: var(--space-8); }
  .group { display: grid; gap: var(--space-4); }
  @media (min-width: 900px) { .group { grid-template-columns: 1fr 2fr; gap: var(--space-8); } }
  .group h2 { font-size: var(--step-3); padding-inline-start: var(--space-4); border-inline-start: 6px solid var(--line, var(--c-ink)); align-self: start; }
  .group h2 a { color: inherit; }
</style>
