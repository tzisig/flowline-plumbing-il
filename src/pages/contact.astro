---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import ContactForm from '../components/ContactForm.astro';
import DispatchStatus from '../components/DispatchStatus.astro';
import { contact } from '../config/site.config';
import { breadcrumbSchema, home } from '../lib/schema';
import { waLink, telLink } from '../lib/util';

const crumbs = [home, { label: 'צור קשר', href: '/contact/' }];
---
<BaseLayout
  title="צור קשר עם המוקד"
  description="מוקד פלואוליין פעיל 24/7: טלפון, וואטסאפ וטופס. לתקלה דחופה עדיף להתקשר, לעבודה מתוכננת אפשר להשאיר פרטים."
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHead crumbs={crumbs} title="צור קשר" lead="תקלה דחופה? התקשרו, זה הכי מהיר. לעבודה מתוכננת או להצעת מחיר אפשר גם וואטסאפ או טופס." />
  <section class="section">
    <div class="wrap grid">
      <div class="ways">
        <a class="way urgent" href={telLink}><Icon name="phone" size={28} /><span><strong>מוקד 24/7</strong><span dir="ltr" class="tnum">{contact.phone}</span></span></a>
        <a class="way" href={waLink()} target="_blank" rel="noopener"><Icon name="whatsapp" size={28} /><span><strong>וואטסאפ</strong><span>אפשר לצרף תמונה של התקלה</span></span></a>
        <a class="way" href={`mailto:${contact.email}`}><Icon name="mail" size={26} /><span><strong>מייל</strong><span>{contact.email}</span></span></a>
        <div class="way static"><Icon name="pin" size={26} /><span><strong>המוקד</strong><span>{contact.street}</span></span></div>
        <DispatchStatus variant="card" />
        <p class="small">{contact.officeHours}.</p>
      </div>
      <div class="form-box">
        <h2>השאירו פרטים</h2>
        <p class="small">המוקד יחזור אליכם. בשעות היום תוך חצי שעה.</p>
        <ContactForm id="contact" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .grid { display: grid; gap: var(--space-7); }
  @media (min-width: 900px) { .grid { grid-template-columns: 1fr 1.2fr; gap: var(--space-8); align-items: start; } }
  .ways { display: grid; gap: var(--space-3); }
  .way { display: flex; align-items: center; gap: var(--space-4); padding: var(--space-4); background: var(--c-panel); border: 1.5px solid var(--c-line); border-radius: var(--radius); text-decoration: none; color: var(--c-text); }
  a.way:hover { border-color: var(--c-coral); }
  .way.urgent { border-color: var(--c-coral); border-width: 2px; }
  .way :global(svg) { color: var(--c-coral); flex: none; }
  .way > span { display: grid; line-height: 1.35; }
  .way strong { font-size: 1.2rem; font-weight: 800; font-stretch: 87.5%; color: var(--c-ink); }
  .urgent [dir] { font-size: 1.4rem; font-weight: 800; }
  .ways :global([data-dispatch]) { margin-top: var(--space-3); }
  .small { font-size: 0.9rem; color: var(--c-muted); }
  .form-box { background: var(--c-panel); border-radius: var(--radius); padding: var(--space-6); }
  .form-box h2 { font-size: var(--step-3); margin-bottom: var(--space-2); }
  .form-box .small { margin-bottom: var(--space-5); }
</style>
