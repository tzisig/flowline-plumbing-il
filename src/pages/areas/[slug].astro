---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import Icon from '../../components/Icon.astro';
import DispatchMap from '../../components/DispatchMap.astro';
import DispatchStatus from '../../components/DispatchStatus.astro';
import ReviewList from '../../components/ReviewList.astro';
import JobCard from '../../components/JobCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { areas, services, jobs, reviews, site, type Area } from '../../config/site.config';
import { breadcrumbSchema, businessRef, home } from '../../lib/schema';
import { waLink, telLink, price } from '../../lib/util';

export function getStaticPaths() {
  return areas.map((a) => ({ params: { slug: a.slug }, props: { area: a } }));
}
interface Props { area: Area }
const { area: a } = Astro.props;

const crumbs = [home, { label: 'אזורי שירות', href: '/areas/' }, { label: a.name, href: `/areas/${a.slug}/` }];
const job = jobs.find((j) => j.area === a.slug);
const hasReview = reviews.some((r) => r.area === a.slug);
const nearby = a.nearby.map((slug) => areas.find((x) => x.slug === slug)!);
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `אינסטלטור ב${a.name}`,
  serviceType: 'אינסטלציה',
  provider: businessRef,
  areaServed: { '@type': 'City', name: a.name },
  url: `${site.url}/areas/${a.slug}/`,
};
---
<BaseLayout
  title={`${a.keyword}: מוקד 24/7, הגעה תוך כ-${a.minutes} דקות`}
  description={`אינסטלטור ב${a.name} בכל שעה: פיצוץ צנרת, סתימות, נזילות ודודים. הגעה תוך כ-${a.minutes} דקות מהמוקד, מחיר לפני עבודה ובלי תוספת לילה.`}
  schema={[breadcrumbSchema(crumbs), serviceSchema]}
  ogImage={a.image}
>
  <PageHead crumbs={crumbs} title={`אינסטלטור ב${a.name}`} lead={a.intro} image={a.image} imageAlt={a.imageAlt}>
    <DispatchStatus variant="card" area={a.slug} />
    <div class="actions">
      <a class="btn" href={telLink}><Icon name="phone" size={19} />התקשרו למוקד</a>
      <a class="btn btn--wa" href={waLink(`שלום, אני צריך אינסטלטור ב${a.name}`)} target="_blank" rel="noopener"><Icon name="whatsapp" size={20} />וואטסאפ</a>
    </div>
  </PageHead>

  <section class="section flow">
    <div class="wrap">
      <h2 class="station h">מה מיוחד ב{a.name}</h2>
      <div class="local">{a.local.map((l) => <article><h3>{l.title}</h3><p>{l.text}</p></article>)}</div>
      <p class="hoods"><Icon name="pin" size={16} /> מגיעים לכל השכונות, בהן: {a.neighborhoods.join(', ')}</p>
    </div>
  </section>

  <section class="section section--fog flow">
    <div class="wrap two">
      <div>
        <h2 class="station h">השירותים ב{a.name}</h2>
        <ul class="svc">
          {services.map((s) => (
            <li style={`--line:${s.color}`}>
              <a href={`/services/${s.slug}/`}>{s.title}</a>
              <span>מ-{price(Math.min(...s.prices.map((p) => p.from)))}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="map-box on-dark"><DispatchMap current={a.slug} animate={false} /></div>
    </div>
  </section>

  {(job || hasReview) && (
    <section class="section flow flow--end">
      <div class="wrap">
        <h2 class="station h">מהקריאות ב{a.name}</h2>
        <div class="proof">
          {job && <JobCard job={job} />}
          {hasReview && <ReviewList area={a.slug} />}
        </div>
      </div>
    </section>
  )}

  <section class="section section--fog">
    <div class="wrap">
      <h2 class="h">ערים סמוכות</h2>
      <ul class="near">{nearby.map((n) => <li><a href={`/areas/${n.slug}/`}>אינסטלטור ב{n.name}</a> <span class="muted">כ-{n.minutes} דקות מהמוקד</span></li>)}</ul>
    </div>
  </section>

  <CtaBand area={a.slug} title={`תקלה ב${a.name}? המוקד עונה.`} waText={`שלום, אני צריך אינסטלטור ב${a.name}`} />
</BaseLayout>

<style>
  .h { font-size: var(--step-3); margin-bottom: var(--space-6); }
  .local { display: grid; gap: var(--space-5); }
  @media (min-width: 900px) { .local { grid-template-columns: repeat(3, 1fr); } }
  .local article { background: var(--c-panel); border-radius: var(--radius); padding: var(--space-5); }
  .local h3 { margin-bottom: var(--space-2); }
  .hoods { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; margin-top: var(--space-6); color: var(--c-muted); }
  .two { display: grid; gap: var(--space-7); align-items: start; }
  @media (min-width: 1000px) { .two { grid-template-columns: 1fr 1fr; gap: var(--space-8); } }
  .svc { list-style: none; padding: 0; display: grid; }
  .svc li { display: flex; justify-content: space-between; gap: var(--space-4); padding: 0.7rem 0; padding-inline-start: var(--space-4); border-bottom: 1px solid var(--c-line); border-inline-start: 5px solid var(--line); }
  .svc a { font-weight: 750; color: var(--c-ink); }
  .svc span { font-weight: 600; white-space: nowrap; }
  .map-box { background: var(--c-ink); border-radius: var(--radius); padding: var(--space-6); }
  .proof { display: grid; gap: var(--space-5); align-items: start; }
  @media (min-width: 900px) { .proof { grid-template-columns: 1fr 1fr; } }
  .proof :global(.reviews) { grid-template-columns: 1fr; }
  .near { list-style: none; padding: 0; display: grid; gap: var(--space-2); font-size: 1.1rem; }
  .near a { font-weight: 700; }
</style>
