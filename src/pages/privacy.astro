---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import { site, contact, legal } from '../config/site.config';
import { breadcrumbSchema, home } from '../lib/schema';
import { formatDate, telLink } from '../lib/util';

const crumbs = [home, { label: 'מדיניות פרטיות', href: '/privacy/' }];
---
<BaseLayout title="מדיניות פרטיות" description={`מדיניות הפרטיות של ${site.name}: איזה מידע נאסף באתר ובהזמנות, למה, איפה הוא נשמר ומה הזכויות שלכם.`} schema={[breadcrumbSchema(crumbs)]}>
  <PageHead crumbs={crumbs} title="מדיניות פרטיות" lead={`עודכן לאחרונה: ${formatDate(legal.privacyUpdated)}`} />
  <section class="section">
    <div class="wrap prose">
      <p>{legal.businessName} ("העסק") מכבד את פרטיות הגולשים באתר ואת פרטיות הלקוחות שלנו. מדיניות זו מסבירה איזה מידע נאסף, לאיזו מטרה, ומה הזכויות שלכם, בהתאם לחוק הגנת הפרטיות, התשמ"א-1981 ותקנותיו, לרבות תיקון 13 לחוק.</p>

      <h2>איזה מידע נאסף</h2>
      <ul>
        <li><strong>מידע שאתם מוסרים בטופס:</strong> שם, טלפון, נושא הפנייה ופרטים שבחרתם לכתוב.</li>
        <li><strong>מידע לביצוע העבודה:</strong> כתובת, תמונות של התקלה ופרטי ועד הבית או חברת הביטוח, אם מסרתם. המידע נמסר בטלפון או בוואטסאפ ומשמש רק לקריאה.</li>
        <li><strong>מידע טכני:</strong> העמוד שממנו נשלחה הפנייה ומקור ההגעה לאתר (למשל פרמטרי קמפיין).</li>
        <li><strong>עוגיות מדידה:</strong> רק אם אישרתם זאת בבאנר העוגיות. בלי אישור, לא נטענים כלי מדידה.</li>
      </ul>
      <p>בדיקת מד המים, מחשבון המחירים ומפת זמני ההגעה פועלים בדפדפן שלכם ולא שולחים לנו מידע.</p>

      <h2>למה המידע משמש</h2>
      <p>כדי לחזור אליכם, לשלוח טכנאי, להוציא חשבונית ודוח, ולשפר את האתר. המידע לא נמכר ולא מועבר לצד שלישי לצורכי שיווק. הטכנאי מקבל רק את הפרטים הדרושים לקריאה.</p>

      <h2>מסירת המידע אינה חובה</h2>
      <p>אינכם חייבים למסור מידע. בלי פרטי קשר לא נוכל לחזור אליכם, ובלי כתובת לא נוכל לשלוח טכנאי.</p>

      <h2>היכן המידע נשמר</h2>
      <p>המידע נשמר או עובר דרך ספקי שירות שמסייעים בהפעלת האתר:</p>
      <ul>{legal.dataProcessors.map((p) => <li>{p}</li>)}</ul>
      <p>הודעות וואטסאפ מתנהלות בכפוף לתנאים של WhatsApp. ייתכן שחלק מהספקים שומרים מידע מחוץ לישראל, בכפוף להגנות מתאימות.</p>
      <p>את פרטי הקריאות אנחנו שומרים לתקופת האחריות ועוד שנה, לצורך שירות וטיפול באחריות, ואחר כך מוחקים. חשבוניות נשמרות לפי חובות הדיווח לרשויות המס.</p>

      <h2>אבטחת מידע</h2>
      <p>האתר פועל בתקשורת מוצפנת (HTTPS). תשלומים מתבצעים בקישור מאובטח של חברת סליקה, ופרטי כרטיס האשראי לא מגיעים אלינו.</p>

      <h2>הזכויות שלכם</h2>
      <p>אתם רשאים לעיין במידע שנשמר עליכם, לבקש לתקן אותו או למחוק אותו. פנו אלינו בכתובת <a href={`mailto:${contact.email}`}>{contact.email}</a> ונטפל בבקשה בתוך זמן סביר.</p>

      <h2>עוגיות</h2>
      <p>אפשר לשנות את בחירת העוגיות בכל רגע דרך הקישור "הגדרות עוגיות" בתחתית האתר.</p>

      <h2>פרטי קשר</h2>
      <p>{legal.businessName}, עוסק מורשה {legal.businessId}, {contact.street}. טלפון: <a href={telLink} dir="ltr">{contact.phone}</a>.</p>
    </div>
  </section>
</BaseLayout>
