---
import Stars from './Stars.astro';
import { reviews } from '../config/site.config';
import { areaBySlug, serviceBySlug } from '../lib/util';
interface Props { limit?: number; area?: string }
const { limit, area } = Astro.props;
let list = area ? reviews.filter((r) => r.area === area) : reviews;
if (limit) list = list.slice(0, limit);
---
<ul class="reviews">
  {list.map((r) => {
    const s = serviceBySlug(r.service);
    return (
      <li style={`--line:${s.color}`}>
        <figure>
          <Stars rating={r.rating} />
          <blockquote><p>{r.text}</p></blockquote>
          <figcaption><strong>{r.name}</strong>, {areaBySlug(r.area).name}<span class="svc">{s.title}</span></figcaption>
        </figure>
      </li>
    );
  })}
</ul>

<style>
  .reviews { list-style: none; padding: 0; display: grid; gap: var(--space-5); }
  @media (min-width: 760px) { .reviews { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .reviews { grid-template-columns: repeat(3, 1fr); } }
  li { display: grid; }
  figure { display: grid; gap: var(--space-3); align-content: start; padding: var(--space-5); background: var(--c-panel); border-radius: var(--radius); border-top: 5px solid var(--line); }
  blockquote { font-size: 1.08rem; line-height: 1.6; }
  figcaption { font-size: 0.9rem; color: var(--c-muted); display: flex; flex-wrap: wrap; gap: 0.3rem; }
  figcaption strong { color: var(--c-text); }
  .svc { flex-basis: 100%; font-weight: 600; color: var(--c-text); }
</style>
